# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Supabase Dashboard → Settings → API → service_role (secret!) -- used
# server-side only (src/lib/supabaseAdmin.ts), never exposed to the browser.
# Required in production for the admin API route (/api/admin/users/[userId]).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
