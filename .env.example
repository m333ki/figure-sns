# Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Supabase Dashboard → Settings → API → service_role (secret!) -- used
# server-side only (src/lib/supabaseAdmin.ts), never exposed to the browser.
# Required in production for the admin API route (/api/admin/users/[userId]).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional -- in-feed ad slot (src/components/AdFeedCard.tsx). Leave unset to
# keep showing the placeholder card. If set, both AdSense vars are required
# together for a real AdSense unit to render.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_ID=xxxxxxxxxx

# Optional -- generic affiliate banner shown in the same ad slot when AdSense
# isn't configured (e.g. an Amazon/Rakuten campaign page).
NEXT_PUBLIC_AFFILIATE_BANNER_URL=
NEXT_PUBLIC_AFFILIATE_BANNER_LABEL=
